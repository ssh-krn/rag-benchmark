# Primary & Fallback Free-Tier LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIza_your_google_gemini_api_key_here
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# Ollama Cloud Configuration (Zero-VRAM for Integrated GPU; subject to rate/session limits)
# Option A (Local Ollama Proxy): Run `ollama signin` once in terminal and leave OLLAMA_API_KEY blank
# Option B (Direct Cloud API): Set OLLAMA_BASE_URL=https://ollama.com and provide OLLAMA_API_KEY
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_LIGHTRAG_MODEL=deepseek-v4.1-flash:cloud
OLLAMA_JUDGE_FALLBACK_MODEL=deepseek-v4.1-flash:cloud
OLLAMA_COOLDOWN_SECONDS=300
# Genuinely LOCAL (non-:cloud) Ollama model — no API key, no cloud routing.
# `ollama pull qwen2.5:3b` first. Used by default by
# scripts/offline_build_graph.py (pass --allow-cloud-fallback to use the
# Groq -> Gemini -> Ollama:cloud chain instead).
+OLLAMA_LOCAL_MODEL=qwen2.5:3b

# Verified Free-Tier Model Preferences
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_GRADER_MODEL=openai/gpt-oss-20b
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Local Storage Paths (Pre-Populated Offline)
CHROMA_DIR=./chroma_db
DEFAULT_COLLECTION_NAME=machine-learning
GRAPH_DIR=./lightrag_graphs
DEFAULT_GRAPH_NAME=machine-learning_graph.graphml

# Local Embeddings & Reranker (CPU / iGPU Safe)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=./cache
LOCAL_FILES_ONLY=true

# DeepEval Rate-Limit & Caching Settings
EVAL_CACHE_DIR=./eval_cache
EVAL_RUNS_DIR=./eval_runs
EVAL_BATCH_SIZE=3
EVAL_BATCH_SLEEP_SECONDS=15.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=45.0

# FastAPI CORS (React Frontend Origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
